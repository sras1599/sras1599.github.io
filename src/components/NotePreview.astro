---
/**
 * Preview collection entries from their existing page HTML. Entry-page templates
 * include this component; the collection registry supplies eligible target routes
 * without a separate collection list. Hover or keyboard focus fetches the article
 * header and body into a scrollable panel, caching successful responses for this
 * page's lifetime. Heading and block fragments initially scroll only the preview
 * to their target, with the whole note available above and below. Links marked
 * data-no-preview, indexes, external links,
 * same-page anchors navigate normally. Touch taps open a modal bottom sheet;
 * its toolbar's Open page link opens the note. Target pages must use
 * the shared article markup. The opt-out depends on attribute presence, not value.
 * Eligible links receive an inline blue highlight and ink border, using the same
 * eligibility rule as the preview behavior so other links keep their usual style.
 */
import { CollectionRegistry } from "../collections/registry.mjs";
---

<aside
  id="note-preview"
  class="note-preview"
  aria-label="Note preview"
  tabindex="0"
  data-routes={JSON.stringify(
    Array.from(CollectionRegistry.values(), (collection) => collection.route)
      .filter((route) => route !== "/"),
  )}
  hidden
>
</aside>
<dialog class="note-preview-sheet" aria-label="Note preview">
  <div class="note-preview-sheet-controls">
    <div class="note-preview-sheet-label">
      <span>Preview</span>
      <span aria-hidden="true">·</span>
      <a class="note-preview-open-page" data-no-preview>Open page</a>
    </div>
    <button type="button" aria-label="Close note preview" autofocus>
      <span aria-hidden="true">×</span>
    </button>
  </div>
</dialog>

<script>
  const panel = document.querySelector<HTMLElement>("#note-preview")!;
  const sheet = document.querySelector<HTMLDialogElement>(".note-preview-sheet")!;
  const closeButton = sheet.querySelector<HTMLButtonElement>("button")!;
  const openPageLink = sheet.querySelector<HTMLAnchorElement>(".note-preview-open-page")!;
  const routes: string[] = JSON.parse(panel.dataset.routes!);
  const cache = new Map<string, HTMLElement[]>();
  let activeLink: HTMLAnchorElement | null = null;
  let openTimer: ReturnType<typeof setTimeout> | undefined;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  let pointerType = "";
  let previousOverflow = "";
  let restoringFocus = false;
  let swipe: { identifier: number; x: number; y: number; distance: number } | null = null;
  let suppressSwipeClick = false;

  function resetSheetDrag() {
    swipe = null;
    sheet.removeAttribute("data-dragging");
    sheet.style.removeProperty("translate");
  }

  /** Find eligible entry links, respecting data-no-preview and excluding recursive previews. */
  function noteLink(target: EventTarget | null) {
    if (!(target instanceof Element) || panel.contains(target)) return null;
    const link = target.closest<HTMLAnchorElement>("a[href]");
    if (!link || link.hasAttribute("download")) return null;
    if (link.hasAttribute("data-no-preview")) return null;

    const url = new URL(link.href);
    if (url.origin !== location.origin) return null;
    const pathname = url.pathname.replace(/\/$/, "");
    if (pathname === location.pathname.replace(/\/$/, "")) return null;
    if (routes.includes(pathname)) return null;
    if (!routes.some((route) => pathname.startsWith(`${route}/`))) return null;
    return link;
  }

  // Mark only links that can open this panel. Links inside fetched previews are
  // not marked because the component deliberately excludes recursive previews.
  document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    if (noteLink(link)) link.setAttribute("data-preview-link", "");
  });

  /** Keep the panel beside its trigger and inside the available viewport. */
  function positionPanel() {
    if (!activeLink || panel.hidden || sheet.open) return;
    const rect = activeLink.getBoundingClientRect();
    const margin = 12;
    const gap = 8;
    const below = window.innerHeight - rect.bottom - margin - gap;
    const above = rect.top - margin - gap;
    const placeBelow =
      below >= Math.min(360, window.innerHeight * 0.6) || below >= above;
    panel.style.maxHeight = `${Math.max(0, placeBelow ? below : above)}px`;
    panel.style.left = `${Math.max(margin, Math.min(rect.left, window.innerWidth - panel.offsetWidth - margin))}px`;
    panel.style.top = `${placeBelow ? rect.bottom + gap : Math.max(margin, rect.top - panel.offsetHeight - gap)}px`;
  }

  /** Cancel pending work and hide the panel; stale fetches cannot reopen it. */
  function dismiss() {
    clearTimeout(openTimer);
    clearTimeout(closeTimer);
    panel.hidden = true;
    const trigger = activeLink;
    activeLink = null;
    if (sheet.open) {
      resetSheetDrag();
      restoringFocus = true;
      sheet.close();
      sheet.before(panel);
      document.body.style.overflow = previousOverflow;
      trigger?.focus({ preventScroll: true });
      restoringFocus = false;
    }
  }

  /** Allow the pointer to cross the gap, and keep focused previews readable. */
  function scheduleClose() {
    if (sheet.open) return;
    clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      if (panel.matches(":hover") || panel.contains(document.activeElement))
        return;
      if (
        activeLink?.matches(":hover") ||
        activeLink === document.activeElement
      )
        return;
      dismiss();
    }, 180);
  }

  /**
   * Fetch an entry on demand and copy its rendered content. Resolve relative URLs
   * against the fetched page, retaining IDs only as data attributes so fragments
   * can locate cloned content without colliding with IDs on this page.
   * Failed requests show a navigation fallback and remain retryable.
   */
  async function showPreview(link: HTMLAnchorElement) {
    const url = new URL(link.href);
    const fragment = url.hash.slice(1);
    url.hash = "";
    url.search = "";
    panel.textContent = "Loading note…";
    panel.hidden = false;
    positionPanel();

    try {
      let content = cache.get(url.href);
      if (!content) {
        const response = await fetch(url.href);
        if (!response.ok)
          throw new Error(
            `Preview request failed for ${url.href}: ${response.status}`,
          );
        const page = new DOMParser().parseFromString(
          await response.text(),
          "text/html",
        );
        const header = page.querySelector<HTMLElement>(
          ".article > .article-header",
        );
        const body = page.querySelector<HTMLElement>(
          ".article > .article-body",
        );
        if (!header || !body)
          throw new Error(`No note content found at ${url.href}`);
        content = [header, body];

        for (const section of content) {
          section
            .querySelectorAll("script, iframe, object, embed")
            .forEach((node) => node.remove());
          for (const element of [section, ...section.querySelectorAll("*")]) {
            const id = element.getAttribute("id");
            if (id !== null) element.setAttribute("data-preview-anchor", id);
            element.removeAttribute("id");
            for (const attribute of ["href", "src", "poster"]) {
              const value = element.getAttribute(attribute);
              if (value)
                element.setAttribute(
                  attribute,
                  new URL(value, response.url).href,
                );
            }
          }
        }
        cache.set(url.href, content);
      }

      if (activeLink !== link) return;
      panel.replaceChildren(...content.map((node) => node.cloneNode(true)));
      panel.scrollTop = 0;
      positionPanel();
      scrollToFragment(fragment);
    } catch {
      if (activeLink !== link) return;
      const fallback = document.createElement("a");
      fallback.href = link.href;
      fallback.textContent = "Preview unavailable. Open note →";
      panel.replaceChildren(fallback);
      positionPanel();
    }
  }

  function scrollToFragment(fragment: string) {
    if (!fragment) return;

    let anchor: string;
    try {
      anchor = decodeURIComponent(fragment);
    } catch {
      return;
    }

    // Compare values rather than putting authored IDs into a CSS selector.
    const target = Array.from(panel.querySelectorAll<HTMLElement>("[data-preview-anchor]"))
      .find((element) => element.dataset.previewAnchor === anchor);
    if (!target) return;

    const padding = parseFloat(getComputedStyle(panel).paddingTop);
    const headerHeight = sheet.open
      ? panel.querySelector(".article-header")?.getBoundingClientRect().height ?? 0
      : 0;
    panel.scrollTop += target.getBoundingClientRect().top -
      panel.getBoundingClientRect().top - panel.clientTop - padding - headerHeight;
  }

  /** Briefly delay opening so passing across a list does not fetch every note. */
  function scheduleOpen(link: HTMLAnchorElement) {
    clearTimeout(closeTimer);
    if (activeLink === link) return;
    dismiss();
    activeLink = link;
    openTimer = setTimeout(() => void showPreview(link), 250);
  }

  document.addEventListener("pointerover", (event) => {
    pointerType = event.pointerType;
    if (event.pointerType === "touch") return;
    const link = noteLink(event.target);
    if (link) scheduleOpen(link);
  });
  document.addEventListener("pointerout", (event) => {
    if (noteLink(event.target)) scheduleClose();
  });
  document.addEventListener("focusin", (event) => {
    if (sheet.open || restoringFocus || pointerType === "touch") return;
    const link = noteLink(event.target);
    if (link) scheduleOpen(link);
    else if (!panel.contains(event.target as Node)) dismiss();
  });
  document.addEventListener("focusout", scheduleClose);
  panel.addEventListener("pointerenter", () => clearTimeout(closeTimer));
  panel.addEventListener("pointerleave", scheduleClose);
  document.addEventListener("keydown", (event) => {
    pointerType = "";
    if (sheet.open) return;
    // Arrow Down moves keyboard readers into the scrollable preview; Escape
    // returns them to the originating link without navigating away.
    if (
      event.key === "ArrowDown" &&
      !panel.hidden &&
      document.activeElement === activeLink
    ) {
      event.preventDefault();
      panel.focus({ preventScroll: true });
      return;
    }
    if (event.key !== "Escape") return;
    if (panel.contains(document.activeElement)) activeLink?.focus();
    dismiss();
  });
  document.addEventListener("pointerdown", (event) => {
    pointerType = event.pointerType;
    if (sheet.open) return;
    if (!panel.contains(event.target as Node)) dismiss();
  });
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
      event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = noteLink(event.target);
    if (!link || (link.target && link.target !== "_self")) return;
    const touchActivation = pointerType === "touch" ||
      (event.detail > 0 && window.matchMedia("(hover: none)").matches);
    if (!touchActivation) return;
    event.preventDefault();
    dismiss();
    activeLink = link;
    openPageLink.href = link.href;
    panel.hidden = false;
    sheet.append(panel);
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    sheet.showModal();
    closeButton.focus({ preventScroll: true });
    void showPreview(link);
  });
  closeButton.addEventListener("click", dismiss);
  openPageLink.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
      event.ctrlKey || event.shiftKey || event.altKey) return;
    dismiss();
  });
  sheet.addEventListener("cancel", (event) => {
    event.preventDefault();
    dismiss();
  });
  sheet.addEventListener("click", (event) => {
    if (event.target !== sheet) return;
    const rect = sheet.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right ||
      event.clientY < rect.top || event.clientY > rect.bottom) dismiss();
  });

  // Claim only downward gestures that begin at the top. Other gestures keep
  // native scrolling, horizontal code scrolling, text selection, and zooming.
  sheet.addEventListener("touchstart", (event) => {
    resetSheetDrag();
    suppressSwipeClick = false;
    if (event.touches.length !== 1 || panel.scrollTop > 1) return;
    if (!window.getSelection()?.isCollapsed) return;
    const target = event.target;
    if (!(target instanceof Element) || target === sheet) return;
    if (target.closest("a, button, input, textarea, select, audio, video, pre, [contenteditable]")) return;
    // A nested scrollable element should retain its own touch interaction.
    for (let element = target; element !== panel && element !== sheet; element = element.parentElement!) {
      if (element.scrollHeight > element.clientHeight &&
        /auto|scroll/.test(getComputedStyle(element).overflowY)) return;
    }
    const touch = event.touches[0];
    swipe = { identifier: touch.identifier, x: touch.clientX, y: touch.clientY, distance: 0 };
  }, { passive: true });

  sheet.addEventListener("touchmove", (event) => {
    if (!swipe) return;
    if (event.touches.length !== 1) {
      resetSheetDrag();
      return;
    }
    const touch = Array.from(event.touches)
      .find((touch) => touch.identifier === swipe!.identifier);
    if (!touch) return;
    const distance = touch.clientY - swipe.y;
    const horizontal = Math.abs(touch.clientX - swipe.x);
    if (!sheet.hasAttribute("data-dragging")) {
      if (Math.max(Math.abs(distance), horizontal) < 8) return;
      if (distance <= horizontal || panel.scrollTop > 1) {
        resetSheetDrag();
        return;
      }
    }
    if (!event.cancelable) {
      resetSheetDrag();
      return;
    }
    event.preventDefault();
    sheet.setAttribute("data-dragging", "");
    swipe.distance = Math.max(0, distance);
    sheet.style.translate = `0 ${swipe.distance}px`;
    suppressSwipeClick = true;
  }, { passive: false });

  sheet.addEventListener("touchend", () => {
    if (!swipe) return;
    const shouldClose = swipe.distance >= Math.min(96, sheet.clientHeight * 0.2);
    if (shouldClose) dismiss();
    else resetSheetDrag();
  });
  sheet.addEventListener("touchcancel", resetSheetDrag);
  sheet.addEventListener("click", (event) => {
    if (!suppressSwipeClick || event.detail === 0) return;
    suppressSwipeClick = false;
    event.preventDefault();
    event.stopImmediatePropagation();
  }, true);
  // Scrolling inside the preview preserves it; scrolling the page dismisses it.
  document.addEventListener(
    "scroll",
    (event) => {
      if (sheet.open) return;
      if (event.target instanceof Node && panel.contains(event.target)) return;
      dismiss();
    },
    true,
  );
  window.addEventListener("resize", () => {
    if (!sheet.open) dismiss();
  });
  // History can restore the existing document, including an open native dialog.
  // Leave the source page ready for reading before the browser caches it.
  window.addEventListener("pagehide", dismiss);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) dismiss();
  });
</script>

<style is:global>
  /* Small inline labels echo the site's bordered cards without interrupting
     wrapping or shifting the surrounding text when hovered or focused. */
  a[data-preview-link]:not([data-no-preview]) {
    color: var(--ink);
    background: var(--purple-soft);
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    padding: 0.02em 0.2em;
    border-radius: 2px;
    text-decoration: none;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  a[data-preview-link]:not([data-no-preview]):focus-visible {
    background: var(--purple);
    box-shadow: 1px 1px 0 var(--ink);
  }

  @media (hover: hover) {
    a[data-preview-link]:not([data-no-preview]):hover {
      background: var(--purple);
      box-shadow: 1px 1px 0 var(--ink);
    }
  }

  a[data-preview-link]:not([data-no-preview]):focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .note-preview {
    position: fixed;
    z-index: 100;
    width: min(32rem, calc(100vw - 24px));
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    border: 2px solid var(--ink);
    background: var(--paper-high);
    box-shadow: 3px 3px 0 var(--blue-soft);
    overflow-wrap: anywhere;
  }

  .note-preview:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .note-preview .article-header {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
  }

  .note-preview .article-header h2 {
    font-size: 1.6rem;
  }

  .note-preview .article-header p,
  .note-preview .article-body {
    font-size: 0.95rem;
  }

  .note-preview pre {
    overflow-x: auto;
  }

  .note-preview-sheet {
    position: fixed;
    inset: auto 0 0;
    margin: 0 auto;
    padding: 0;
    width: min(100%, 40rem);
    max-width: 100%;
    height: 75dvh;
    max-height: calc(100dvh - 24px);
    overflow: hidden;
    color: var(--ink);
    background: var(--paper-high);
    border: 2px solid var(--ink);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    transition: translate 180ms ease-out;
  }

  .note-preview-sheet[data-dragging] {
    transition: none;
  }

  .note-preview-sheet[open] {
    display: flex;
    flex-direction: column;
    animation: note-preview-rise 220ms ease-out;
  }

  .note-preview-sheet::backdrop {
    background: rgb(0 0 0 / 35%);
  }

  .note-preview-sheet-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .note-preview-sheet-controls button {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--ink);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 1.875rem;
    cursor: pointer;
  }

  .note-preview-sheet-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .note-preview-open-page {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .note-preview-sheet .note-preview {
    position: static;
    width: 100%;
    min-height: 0;
    flex: 1;
    max-height: none !important;
    border: 0;
    box-shadow: none;
    padding: 0 1.25rem max(1.25rem, env(safe-area-inset-bottom));
  }

  .note-preview-sheet .article-header {
    position: sticky;
    top: 0;
    z-index: 1;
    padding-top: 1rem;
    background: var(--paper-high);
  }

  @keyframes note-preview-rise {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-preview-sheet[open] { animation: none; }
    .note-preview-sheet { transition: none; }
  }
</style>
