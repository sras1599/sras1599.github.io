---
/**
 * Enhance authored content images in the browser without changing published
 * Markdown or the HTML fetched by note previews. Linked images also open the
 * lightbox; the native modal dialog owns focus containment and Escape dismissal.
 */
---

<dialog id="image-zoom" aria-label="Enlarged image">
  <button class="image-zoom-close" type="button" autofocus>Close</button>
  <figure class="image-zoom-figure">
    <img class="image-zoom-image" alt="" />
    <figcaption class="image-zoom-caption" hidden></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#image-zoom")!;
  const enlargedImage = dialog.querySelector<HTMLImageElement>("img")!;
  const caption = dialog.querySelector<HTMLElement>("figcaption")!;
  const closeButton = dialog.querySelector<HTMLButtonElement>("button")!;
  let activeImage: HTMLImageElement | null = null;
  let pointerStartedOnBackdrop = false;

  function openImage(image: HTMLImageElement) {
    if (dialog.open) return;

    activeImage = image;
    enlargedImage.src = image.currentSrc || image.src;
    enlargedImage.alt = image.alt;
    const captionText = image.closest("figure")
      ?.querySelector("figcaption")?.textContent?.trim();
    caption.textContent = captionText || "";
    caption.hidden = !captionText;

    dialog.showModal();
    document.documentElement.classList.add("image-zoom-open");
  }

  document
    .querySelectorAll<HTMLImageElement>(
      ".article-body img, .blog-index-body img, .notes-index-body img",
    )
    .forEach((image) => {
      if (image.closest(".note-preview")) return;

      image.classList.add("image-zoom-trigger");
      image.tabIndex = 0;
      image.setAttribute("role", "button");
      image.setAttribute(
        "aria-label",
        image.alt.trim() ? `Enlarge image: ${image.alt}` : "Enlarge image",
      );
      image.setAttribute("aria-haspopup", "dialog");
      image.setAttribute("aria-controls", dialog.id);

      // Image-only links use the image as their single keyboard trigger. Links
      // containing text keep a separate focus stop for their authored destination.
      const link = image.closest("a[href]");
      if (
        link instanceof HTMLAnchorElement &&
        !link.textContent?.trim() &&
        link.querySelectorAll("img").length === 1
      ) {
        link.tabIndex = -1;
      }

      image.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openImage(image);
      });
      image.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        event.stopPropagation();
        if (!event.repeat) openImage(image);
      });
    });

  closeButton.addEventListener("click", () => dialog.close());

  function isBackdrop(event: MouseEvent) {
    if (event.target !== dialog) return false;
    const bounds = dialog.getBoundingClientRect();
    return (
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom
    );
  }

  // Require the gesture to start outside as well, so dragging off the image
  // does not accidentally dismiss the dialog.
  dialog.addEventListener("pointerdown", (event) => {
    pointerStartedOnBackdrop = isBackdrop(event);
  });
  dialog.addEventListener("click", (event) => {
    if (pointerStartedOnBackdrop && isBackdrop(event)) dialog.close();
    pointerStartedOnBackdrop = false;
  });
  dialog.addEventListener("close", () => {
    document.documentElement.classList.remove("image-zoom-open");
    activeImage?.focus({ preventScroll: true });
    activeImage = null;
    pointerStartedOnBackdrop = false;
    enlargedImage.removeAttribute("src");
    enlargedImage.alt = "";
    caption.textContent = "";
    caption.hidden = true;
  });
</script>

<style>
  :global(html.image-zoom-open),
  :global(html.image-zoom-open body) {
    overflow: hidden;
  }

  :global(.image-zoom-trigger) {
    cursor: zoom-in;
  }

  :global(.image-zoom-trigger:focus-visible),
  .image-zoom-close:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  dialog {
    width: max-content;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
    padding: 1rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    overscroll-behavior: contain;
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 75%);
  }

  .image-zoom-close {
    align-self: flex-end;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    border: 2px solid var(--ink);
    background: var(--yellow);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .image-zoom-figure {
    min-width: 0;
    margin: 0;
  }

  .image-zoom-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 12rem);
    margin-inline: auto;
    object-fit: contain;
  }

  .image-zoom-caption {
    max-height: 4rem;
    overflow: auto;
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    overflow-wrap: anywhere;
    contain: inline-size;
  }
</style>
