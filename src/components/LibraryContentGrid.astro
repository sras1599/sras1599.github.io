---
interface Props {
  category: string;
}

const { category } = Astro.props;
const creatorLabels: Record<string, string> = {
  books: "Author",
  "film-and-tv": "Director",
  music: "Artist",
};
const creatorLabel = creatorLabels[category] ?? "Creator";
const items = await Astro.slots.render("default");
const hasItems = Boolean(items?.replace(/<!--[\s\S]*?-->/g, "").trim());
---

<library-content-grid data-category={category}>
  <div class="library-controls">
    <span class="sort-select">
        <select data-sort aria-label="Sort by">
          <option value="year-desc">Year · newest first</option>
          <option value="year-asc">Year · oldest first</option>
          <option value="title-asc" selected>Title · A–Z</option>
          <option value="title-desc">Title · Z–A</option>
          <option value="creator-asc">{creatorLabel} · A–Z</option>
          <option value="creator-desc">{creatorLabel} · Z–A</option>
        </select>
    </span>
    <button class="notes-filter" type="button" data-notes-filter aria-pressed="false">Has notes</button>
    {category !== "music" && (
      <button class="ratings-filter" type="button" data-ratings-filter aria-pressed="false">Has ratings</button>
    )}
    <input class="library-search" type="search" data-search aria-label={`Search by title or ${creatorLabel.toLowerCase()}`} placeholder={`Search title or ${creatorLabel.toLowerCase()}…`} />
  </div>
  <!-- Slotted .library-item wrappers supply data-title, data-creator, data-year,
       data-has-notes, and data-has-rating. Moving wrappers preserves expansion. -->
  <div class="content-grid" set:html={items} />
  <p class="empty-state" data-empty hidden={hasItems} aria-live="polite">No items yet.</p>
</library-content-grid>

<script>
  class LibraryContentGrid extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      const sort = this.querySelector<HTMLSelectElement>("[data-sort]")!;
      const search = this.querySelector<HTMLInputElement>("[data-search]")!;
      const notesFilter = this.querySelector<HTMLButtonElement>("[data-notes-filter]")!;
      const ratingsFilter = this.querySelector<HTMLButtonElement>("[data-ratings-filter]");
      const grid = this.querySelector<HTMLElement>(".content-grid")!;
      const entries = [...grid.querySelectorAll<HTMLElement>(".library-item")];
      grid.replaceChildren(...entries);
      const empty = this.querySelector<HTMLElement>("[data-empty]")!;
      const collator = new Intl.Collator("en", { numeric: true, sensitivity: "base" });
      const mobile = window.matchMedia("(max-width: 640px)");
      const columns = Array.from({ length: 2 }, () => {
        const column = document.createElement("div");
        column.className = "content-column";
        return column;
      });
      this.events = new AbortController();

      const apply = () => {
        const [field, direction] = sort.value.split("-");
        const notesOnly = notesFilter.getAttribute("aria-pressed") === "true";
        const ratingsOnly = ratingsFilter?.getAttribute("aria-pressed") === "true";
        const query = search.value.trim().toLocaleLowerCase("en");
        entries.sort((a, b) => {
          const aValue = a.dataset[field] ?? "";
          const bValue = b.dataset[field] ?? "";
          // Missing metadata stays last in either direction.
          if (!aValue && bValue) return 1;
          if (aValue && !bValue) return -1;
          const order = field === "year"
            ? Number(aValue) - Number(bValue)
            : collator.compare(aValue, bValue);
          if (order !== 0) return direction === "desc" ? -order : order;
          return collator.compare(a.dataset.title ?? "", b.dataset.title ?? "");
        });
        if (!mobile.matches) grid.append(...columns);
        let visibleIndex = 0;
        entries.forEach((entry) => {
          const matchesSearch = [entry.dataset.title, entry.dataset.creator]
            .some((value) => (value ?? "").toLocaleLowerCase("en").includes(query));
          entry.hidden = !matchesSearch
            || (notesOnly && entry.dataset.hasNotes !== "true")
            || (ratingsOnly && entry.dataset.hasRating !== "true");
          if (mobile.matches) grid.append(entry);
          else {
            // Filtered books do not consume a place in the left/right sequence.
            const column = entry.hidden ? 0 : visibleIndex++ % 2;
            columns[column].append(entry);
          }
        });
        if (mobile.matches) columns.forEach((column) => column.remove());
        empty.hidden = entries.some((entry) => !entry.hidden);
        if (query) empty.textContent = "No items match your search.";
        else if (notesOnly && ratingsOnly) empty.textContent = "No items with notes and ratings.";
        else if (notesOnly) empty.textContent = "No items with notes.";
        else if (ratingsOnly) empty.textContent = "No rated items.";
        else empty.textContent = "No items yet.";
      };

      sort.addEventListener("change", apply, { signal: this.events.signal });
      search.addEventListener("input", apply, { signal: this.events.signal });
      mobile.addEventListener("change", apply, { signal: this.events.signal });
      for (const filter of [notesFilter, ratingsFilter]) {
        if (!filter) continue;
        filter.addEventListener("click", () => {
          filter.setAttribute("aria-pressed", String(filter.getAttribute("aria-pressed") !== "true"));
          apply();
        }, { signal: this.events.signal });
      }
      apply();
    }

    disconnectedCallback() {
      this.events?.abort();
    }
  }

  if (!customElements.get("library-content-grid")) {
    customElements.define("library-content-grid", LibraryContentGrid);
  }
</script>

<style>
  library-content-grid { display: block; }
  .library-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font: 700 0.75rem "Space Mono", monospace;
  }
  .sort-select { position: relative; }
  .sort-select::after {
    content: "";
    position: absolute;
    right: 0.9rem;
    top: 50%;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  select,
  button,
  input {
    box-sizing: border-box;
    min-height: 2.25rem;
    border: 2px solid var(--ink);
    background: var(--paper-high);
    color: var(--ink);
    font: inherit;
  }
  .library-search {
    flex: 1 1 15rem;
    min-width: 0;
    padding: 0.45rem 0.65rem;
  }
  select {
    appearance: none;
    max-width: 100%;
    padding: 0.45rem 2.25rem 0.45rem 0.65rem;
  }
  button { min-height: 2.25rem; padding: 0.45rem 0.75rem; cursor: pointer; }
  button[aria-pressed="true"] { background: var(--purple-soft); }
  :is(select, button, input):focus { outline: none; }
  :is(select, button, input):focus-visible { box-shadow: inset 0 0 0 1px var(--ink); }
  @media (hover: hover) {
    button[aria-pressed="false"]:hover { background: var(--paper-low); }
  }
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }
  .content-grid :global(.content-column) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .content-grid :global(.library-item) {
    min-width: 0;
  }
  .empty-state { color: var(--muted); }
  @media (max-width: 640px) {
    .library-controls {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .sort-select { grid-column: 1 / -1; min-width: 0; }
    .sort-select select { width: 100%; }
    library-content-grid[data-category="music"] .library-controls {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    library-content-grid[data-category="music"] .sort-select {
      grid-column: auto;
    }
    .library-search { grid-column: 1 / -1; }
    .content-grid { grid-template-columns: 1fr; }
  }
</style>
