---
/**
 * Compose the four production Month cards from normalized game results. This is
 * the Month presentation's small public interface: callers select a calendar
 * month, provide the current local date, and supply validated data. Each card
 * receives a layout-only carousel slide wrapper so looping gaps can be carried
 * by every slide, while game-specific rendering stays behind the private card
 * seam.
 */
import type { GameData } from "../data/games/contracts";
import GameShowcaseMonthCard from "./GameShowcaseMonthCard.astro";

interface Props {
  selectedMonth: string;
  currentLocalDate: string;
  results: GameData;
}

const { selectedMonth, currentLocalDate, results } = Astro.props;
---

<div class="game-carousel-slide">
  <GameShowcaseMonthCard
    game="connections"
    selectedMonth={selectedMonth}
    currentLocalDate={currentLocalDate}
    results={results.connections}
  />
</div>
<div class="game-carousel-slide">
  <GameShowcaseMonthCard
    game="mini"
    selectedMonth={selectedMonth}
    currentLocalDate={currentLocalDate}
    results={results.mini}
  />
</div>
<div class="game-carousel-slide">
  <GameShowcaseMonthCard
    game="bracket-city"
    selectedMonth={selectedMonth}
    currentLocalDate={currentLocalDate}
    results={results["bracket-city"]}
  />
</div>
<div class="game-carousel-slide">
  <GameShowcaseMonthCard
    game="tagline"
    selectedMonth={selectedMonth}
    currentLocalDate={currentLocalDate}
    results={results.tagline}
  />
</div>
