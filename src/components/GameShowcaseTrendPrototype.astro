---
/**
 * Compare three throwaway visual languages for the game showcase's Trends
 * view. The component receives no production data and performs no writes. All
 * charts use a direct, date-aware spline over recorded observations only.
 * The selected treatment places a semantic performance gradient below the
 * curve. Missing dates remain absent; the calendar view owns that detail.
 */
type TrendMetric = {
  key: string;
  title: string;
  measure: string;
  direction: string;
  color: string;
  min: number;
  max: number;
  values: number[];
  summary: "average" | "median";
  failures?: number[];
  perfect?: number[];
  format: (value: number) => string;
};

const variants = [
  {
    key: "B",
    name: "Gradient area",
    note: "The recorded-result spline carries a translucent, performance-colored field beneath it.",
  },
];

const formatSeconds = (seconds: number) => {
  const rounded = Math.round(seconds);
  return `${Math.floor(rounded / 60)}:${String(rounded % 60).padStart(2, "0")}`;
};

const performanceStops = (metric: TrendMetric) => {
  if (metric.key === "connections") {
    return [
      ["0%", "#d6553b"],
      ["34%", "#d6553b"],
      ["41%", "#d7a713"],
      ["84%", "#d7a713"],
      ["91%", "#2f9d63"],
      ["100%", "#2f9d63"],
    ];
  }
  if (metric.key === "mini") {
    return [
      ["0%", "#d6553b"],
      ["30%", "#d6553b"],
      ["36%", "#d7a713"],
      ["64%", "#d7a713"],
      ["70%", "#2f9d63"],
      ["100%", "#2f9d63"],
    ];
  }
  if (metric.key === "bracket") {
    return [
      ["0%", "#2f9d63"],
      ["12%", "#2f9d63"],
      ["18%", "#d7a713"],
      ["37%", "#d7a713"],
      ["43%", "#d6553b"],
      ["100%", "#d6553b"],
    ];
  }
  return [
    ["0%", "#2f9d63"],
    ["22%", "#2f9d63"],
    ["28%", "#d7a713"],
    ["72%", "#d7a713"],
    ["78%", "#d6553b"],
    ["100%", "#d6553b"],
  ];
};

const colorChannels = (hex: string) => [
  Number.parseInt(hex.slice(1, 3), 16),
  Number.parseInt(hex.slice(3, 5), 16),
  Number.parseInt(hex.slice(5, 7), 16),
];

const mixColor = (from: string, to: string, amount: number) => {
  const start = colorChannels(from);
  const end = colorChannels(to);
  const channels = start.map((channel, index) =>
    Math.round(channel + (end[index] - channel) * amount),
  );
  return `rgb(${channels.join(", ")})`;
};

/** Map a recorded value to the same semantic scale used by the spline. */
const performanceColor = (metric: TrendMetric, value: number) => {
  const green = "#2f9d63";
  const yellow = "#d7a713";
  const red = "#d6553b";
  const anchors: Array<[number, string]> =
    metric.key === "connections"
      ? [[0, green], [1, yellow], [2, yellow], [3, red], [4, red]]
      : metric.key === "mini"
        ? [[0, green], [40, green], [60, yellow], [80, red], [120, red]]
        : metric.key === "bracket"
          ? [[0, red], [60, red], [72.5, yellow], [85, green], [100, green]]
          : [[1, red], [2, yellow], [3, green]];

  const upperIndex = anchors.findIndex(([anchorValue]) => value <= anchorValue);
  if (upperIndex <= 0) return anchors[0][1];
  const [lowerValue, lowerColor] = anchors[upperIndex - 1];
  const [upperValue, upperColor] = anchors[upperIndex];
  const amount = (value - lowerValue) / (upperValue - lowerValue);
  return mixColor(lowerColor, upperColor, amount);
};

const metrics: TrendMetric[] = [
  {
    key: "connections",
    title: "Connections",
    measure: "mistakes",
    direction: "lower is better",
    color: "#8b5aa3",
    min: 0,
    max: 4,
    values: [1, 0, 2, 4, 1, 3, 0, 1, 2, 0, 1, 2, 4, 1, 0, 2, 1, 0, 3, 1, 0, 2, 1, 0],
    summary: "average",
    failures: [3, 12],
    format: (value) => value.toFixed(value % 1 === 0 ? 0 : 1),
  },
  {
    key: "mini",
    title: "Mini",
    measure: "solve time",
    direction: "lower is better",
    color: "#327e90",
    min: 0,
    max: 120,
    values: [82, 76, 91, 70, 64, 78, 59, 68, 54, 62, 48, 57, 44, 51, 65, 43, 39, 52, 47, 42, 36, 49, 40, 38],
    summary: "median",
    format: formatSeconds,
  },
  {
    key: "bracket",
    title: "Bracket City",
    measure: "score",
    direction: "higher is better",
    color: "#d36a3f",
    min: 0,
    max: 100,
    values: [62, 74, 68, 81, 77, 85, 72, 88, 91, 79, 84, 93, 87, 96, 82, 90, 94, 86, 97, 89, 92, 100, 95, 98],
    summary: "average",
    perfect: [21],
    format: (value) => Math.round(value).toString(),
  },
  {
    key: "tagline",
    title: "Tagline",
    measure: "stars",
    direction: "higher is better",
    color: "#c18b08",
    min: 1,
    max: 3,
    values: [2, 3, 2, 1, 3, 2, 3, 2, 3, 3, 2, 3, 2, 3, 3, 2, 3, 3, 2, 3, 3, 3, 2, 3],
    summary: "average",
    format: (value) => value.toFixed(1),
  },
];

const chart = { left: 48, right: 568, top: 18, bottom: 206 };

type ChartPoint = { value: number; x: number; y: number };

/**
 * Draw a monotone cubic curve through the supplied values. Clamped tangents
 * prevent the visual line from inventing peaks outside adjacent observations.
 */
const smoothSegments = (points: ChartPoint[]) => {
  if (points.length < 2) return [];

  const intervalSlopes = points.slice(0, -1).map((point, index) => {
    const next = points[index + 1];
    return (next.y - point.y) / (next.x - point.x);
  });
  const tangents = points.map((_, index) => {
    if (index === 0) return intervalSlopes[0];
    if (index === points.length - 1) return intervalSlopes.at(-1)!;
    const before = intervalSlopes[index - 1];
    const after = intervalSlopes[index];
    if (before === 0 || after === 0 || Math.sign(before) !== Math.sign(after)) return 0;
    return (before + after) / 2;
  });

  intervalSlopes.forEach((slope, index) => {
    if (slope === 0) {
      tangents[index] = 0;
      tangents[index + 1] = 0;
      return;
    }
    const leftRatio = tangents[index] / slope;
    const rightRatio = tangents[index + 1] / slope;
    const length = Math.hypot(leftRatio, rightRatio);
    if (length <= 3) return;
    const scale = 3 / length;
    tangents[index] = scale * leftRatio * slope;
    tangents[index + 1] = scale * rightRatio * slope;
  });

  return points.slice(0, -1).map((point, index) => {
    const next = points[index + 1];
    const width = next.x - point.x;
    return `M ${point.x} ${point.y} C ${point.x + width / 3} ${point.y + (tangents[index] * width) / 3}, ${next.x - width / 3} ${next.y - (tangents[index + 1] * width) / 3}, ${next.x} ${next.y}`;
  });
};

const smoothPath = (points: ChartPoint[]) =>
  smoothSegments(points)
    .map((segment, index) =>
      index === 0 ? segment : segment.slice(segment.indexOf("C")),
    )
    .join(" ");

/** Calculate a median for Mini's deliberately robust rolling summary. */
const median = (values: number[]) => {
  const sorted = [...values].sort((left, right) => left - right);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2
    ? sorted[middle]
    : (sorted[middle - 1] + sorted[middle]) / 2;
};

/**
 * Convert one metric into fixed SVG coordinates. The rolling line begins only
 * after seven played results; missing calendar days never enter the window.
 */
const prepareMetric = (metric: TrendMetric) => {
  const x = (index: number) =>
    chart.left +
    (index / (metric.values.length - 1)) * (chart.right - chart.left);
  const y = (value: number) =>
    chart.bottom -
    ((value - metric.min) / (metric.max - metric.min)) *
      (chart.bottom - chart.top);

  const points = metric.values.map((value, index) => ({
    index,
    value,
    x: x(index),
    y: y(value),
  }));
  const rolling = metric.values.map((_, index) => {
    if (index < 6) return null;
    const window = metric.values.slice(index - 6, index + 1);
    const value =
      metric.summary === "median"
        ? median(window)
        : window.reduce((total, result) => total + result, 0) / window.length;
    return { value, x: x(index), y: y(value) };
  });
  const rollingPoints = rolling.filter(
    (point): point is NonNullable<typeof point> => point !== null,
  );
  const rollingPath = smoothPath(rollingPoints);
  const dailyPath = smoothPath(points);
  const groups = Array.from(
    { length: Math.ceil(points.length / 7) },
    (_, groupIndex) => points.slice(groupIndex * 7, groupIndex * 7 + 7),
  );
  const summaries = groups.map((group) => {
    const groupValues = group.map((point) => point.value);
    const value =
      metric.summary === "median"
        ? median(groupValues)
        : groupValues.reduce((total, result) => total + result, 0) / groupValues.length;
    return {
      value,
      x: group.reduce((total, point) => total + point.x, 0) / group.length,
      y: y(value),
      top: y(Math.max(...groupValues)),
      bottom: y(Math.min(...groupValues)),
      count: group.length,
    };
  });
  const summaryPath = smoothPath(summaries);
  const ticks = [metric.min, (metric.min + metric.max) / 2, metric.max].map(
    (value) => ({ value, y: y(value) }),
  );

  return {
    ...metric,
    points,
    rolling,
    rollingPath,
    dailyPath,
    summaries,
    summaryPath,
    directSegments: smoothSegments(points).map((path, index) => ({
      path,
      straightPath: `M ${points[index].x} ${points[index].y} L ${points[index + 1].x} ${points[index + 1].y}`,
      gap: false,
    })),
    gapWindows: [] as { x: number; width: number; label?: string }[],
    monthLabels: [
      { x: 48, label: "APR", anchor: "start" },
      { x: 308, label: "JUL", anchor: "middle" },
      { x: 568, label: "SEP", anchor: "end" },
    ],
    ticks,
  };
};

const preparedMetrics = metrics.map(prepareMetric);

/**
 * Produce calm, deterministic sample histories that resemble gradual changes
 * in play rather than repeating a short, artificially jagged value sequence.
 * Discrete games remain integral while timed and scored games retain nuance.
 */
const syntheticTrendValue = (
  metric: TrendMetric,
  calendarIndex: number,
  progress: number,
) => {
  const shortWave = Math.sin(calendarIndex * 0.31);
  const longWave = Math.sin(calendarIndex * 0.075);

  if (metric.key === "connections") {
    const mistakes = 2.8 - progress * 2.15 + shortWave * 0.42 + longWave * 0.3;
    return Math.max(0, Math.min(4, Math.round(mistakes)));
  }
  if (metric.key === "mini") {
    const seconds = 94 - progress * 48 + shortWave * 4.5 + longWave * 3;
    return Math.max(30, Math.min(120, Math.round(seconds)));
  }
  if (metric.key === "bracket") {
    const score = 62 + progress * 32 + shortWave * 3.2 + longWave * 2.4;
    return Math.max(0, Math.min(100, Math.round(score)));
  }

  const stars = 1.45 + progress * 1.35 + shortWave * 0.22 + longWave * 0.16;
  return Math.max(1, Math.min(3, Math.round(stars)));
};

/**
 * Build B's explicit missing-data scenario on a true calendar axis: ten days
 * are absent in July and three isolated dates are absent in August.
 */
const prepareGapMetric = (metric: TrendMetric) => {
  const day = 24 * 60 * 60 * 1000;
  const start = Date.UTC(2026, 3, 1);
  const end = Date.UTC(2026, 8, 17);
  const longGapStart = Date.UTC(2026, 6, 12);
  const longGapEnd = Date.UTC(2026, 6, 21);
  const isolatedMissing = new Set([
    Date.UTC(2026, 7, 5),
    Date.UTC(2026, 7, 14),
    Date.UTC(2026, 7, 27),
  ]);
  const x = (timestamp: number) =>
    chart.left + ((timestamp - start) / (end - start)) * (chart.right - chart.left);
  const y = (value: number) =>
    chart.bottom -
    ((value - metric.min) / (metric.max - metric.min)) *
      (chart.bottom - chart.top);
  const points = [];

  for (let timestamp = start, calendarIndex = 0; timestamp <= end; timestamp += day, calendarIndex += 1) {
    const inLongGap = timestamp >= longGapStart && timestamp <= longGapEnd;
    if (inLongGap || isolatedMissing.has(timestamp)) continue;
    const progress = (timestamp - start) / (end - start);
    const value = syntheticTrendValue(metric, calendarIndex, progress);
    points.push({
      index: calendarIndex,
      timestamp,
      value,
      x: x(timestamp),
      y: y(value),
    });
  }

  const directSegments = smoothSegments(points).map((path, index) => ({
    path,
    straightPath: `M ${points[index].x} ${points[index].y} L ${points[index + 1].x} ${points[index + 1].y}`,
    gap: points[index + 1].timestamp - points[index].timestamp > day,
  }));
  const ticks = [metric.min, (metric.min + metric.max) / 2, metric.max].map(
    (value) => ({ value, y: y(value) }),
  );
  const gapWindows = [
    {
      x: x(longGapStart),
      width: x(longGapEnd + day) - x(longGapStart),
      label: "10 days",
    },
    ...Array.from(isolatedMissing, (timestamp) => ({
      x: x(timestamp),
      width: x(timestamp + day) - x(timestamp),
    })),
  ];
  const dailyPath = smoothPath(points);
  const areaPath = `${dailyPath} L ${points.at(-1)!.x} ${chart.bottom} L ${points[0].x} ${chart.bottom} Z`;
  const recordedValues = points.map((point) => point.value);
  const rangeSummary =
    metric.summary === "median"
      ? median(recordedValues)
      : recordedValues.reduce((total, value) => total + value, 0) /
        recordedValues.length;
  const areaStops = points
    .filter((_, index) => index % 4 === 0 || index === points.length - 1)
    .map((point) => ({
      offset: `${((point.x - chart.left) / (chart.right - chart.left)) * 100}%`,
      color: performanceColor(metric, point.value),
    }));

  return {
    ...metric,
    points,
    rolling: [],
    rollingPath: "",
    dailyPath,
    areaPath,
    rangeSummary,
    performanceStops: performanceStops(metric),
    areaStops,
    summaries: [],
    summaryPath: "",
    directSegments,
    gapWindows,
    monthLabels: [
      { x: 48, label: "APR", anchor: "start" },
      { x: x(Date.UTC(2026, 6, 1)), label: "JUL", anchor: "middle" },
      { x: 568, label: "SEP", anchor: "end" },
    ],
    ticks,
  };
};

const gapMetrics = metrics.map(prepareGapMetric);
---

<div class="trend-prototype">
  <div class="trend-toolbar">
    <div class="range-control" aria-label="Trend range">
      <button type="button" data-trend-range="3m">3M</button>
      <button type="button" data-trend-range="6m" aria-pressed="true">6M</button>
      <button type="button" disabled title="Not enough synthetic history">1Y</button>
      <button type="button" data-trend-range="all">All</button>
    </div>
    <div class="performance-key" aria-label="Performance colors">
      <span><i class="key-good"></i> good</span>
      <span><i class="key-average"></i> average</span>
      <span><i class="key-poor"></i> poor</span>
    </div>
  </div>

  {
    variants.map((variant, variantIndex) => (
      <section
        class="trend-variant"
        data-trend-variant={variant.key}
        hidden={variantIndex !== 0}
        aria-labelledby={`trend-variant-${variant.key}`}
      >
        <header class="variant-intro">
          <strong id={`trend-variant-${variant.key}`}>
            {variant.key} — {variant.name}
          </strong>
          <span>{variant.note}</span>
        </header>

        <div class="trend-grid">
          {gapMetrics.map((metric) => (
            <article class={`trend-card trend-${metric.key}`} style={`--trend-color: ${metric.color}`}>
              <header>
                <div>
                  <h3>{metric.title}</h3>
                  <p>{metric.measure} · {metric.direction}</p>
                </div>
                <strong>
                  {metric.format(metric.rangeSummary)}
                  <small>in {metric.points.length} games</small>
                </strong>
              </header>

              <svg viewBox="0 0 600 244" role="img" aria-label={`${metric.title} synthetic six-month trend`}>
                <defs>
                  <linearGradient
                    id={`zone-line-${variant.key}-${metric.key}`}
                    x1="0"
                    y1="18"
                    x2="0"
                    y2="206"
                    gradientUnits="userSpaceOnUse"
                  >
                    {metric.performanceStops.map(([offset, color]) => (
                      <stop offset={offset} stop-color={color} />
                    ))}
                  </linearGradient>
                  <linearGradient
                    id={`area-color-${variant.key}-${metric.key}`}
                    x1="48"
                    y1="0"
                    x2="568"
                    y2="0"
                    gradientUnits="userSpaceOnUse"
                  >
                    {metric.areaStops.map((stop) => (
                      <stop offset={stop.offset} stop-color={stop.color} />
                    ))}
                  </linearGradient>
                  <linearGradient
                    id={`area-fade-${variant.key}-${metric.key}`}
                    x1="0"
                    y1="18"
                    x2="0"
                    y2="206"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0%" stop-color="white" stop-opacity="0.8" />
                    <stop offset="100%" stop-color="white" stop-opacity="0.08" />
                  </linearGradient>
                  <mask id={`area-mask-${variant.key}-${metric.key}`}>
                    <rect
                      x="48"
                      y="18"
                      width="520"
                      height="188"
                      fill={`url(#area-fade-${variant.key}-${metric.key})`}
                    />
                  </mask>
                </defs>

                {variant.key === "A" && (
                  <g class="quality-bands" aria-hidden="true">
                    <rect x="48" y="18" width="520" height="62.7" class={metric.direction.startsWith("higher") ? "good-band" : "hard-band"} />
                    <rect x="48" y="80.7" width="520" height="62.7" class="middle-band" />
                    <rect x="48" y="143.4" width="520" height="62.6" class={metric.direction.startsWith("higher") ? "hard-band" : "good-band"} />
                  </g>
                )}

                {variant.key === "B" && (
                  <path
                    class="trend-area"
                    d={metric.areaPath}
                    fill={`url(#area-color-${variant.key}-${metric.key})`}
                    mask={`url(#area-mask-${variant.key}-${metric.key})`}
                  />
                )}

                <g class="grid-lines" aria-hidden="true">
                  {metric.ticks.map((tick) => (
                    <>
                      <line x1="48" x2="568" y1={tick.y} y2={tick.y} />
                      <text x="39" y={tick.y + 3}>{metric.format(tick.value)}</text>
                    </>
                  ))}
                </g>

                <g class="direct-segments">
                  <path class="direct-line-halo" d={metric.dailyPath} />
                  <path
                    class="direct-line"
                    d={metric.dailyPath}
                    style={`stroke: url(#zone-line-${variant.key}-${metric.key})`}
                  />
                </g>

                <g class="time-axis" aria-hidden="true">
                  {metric.monthLabels.map((month) => (
                    <text x={month.x} y="231" text-anchor={month.anchor}>{month.label}</text>
                  ))}
                </g>
              </svg>
            </article>
          ))}
        </div>
      </section>
    ))
  }

</div>

<script>
  /**
   * Drive the throwaway range controls. The URL exposes the selected state;
   * the synthetic plot itself intentionally remains fixed at six months.
   */
  const trendPrototype = document.querySelector<HTMLElement>(".trend-prototype");

  if (trendPrototype) {
    const rangeButtons = trendPrototype.querySelectorAll<HTMLButtonElement>("[data-trend-range]");

    const selectRange = (range: string) => {
      rangeButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.trendRange === range));
      });
      const url = new URL(window.location.href);
      url.searchParams.set("range", range);
      window.history.replaceState({}, "", url);
    };
    const requestedRange = new URL(window.location.href).searchParams.get("range");
    selectRange(requestedRange === "3m" || requestedRange === "all" ? requestedRange : "6m");
    rangeButtons.forEach((button) => {
      button.addEventListener("click", () => selectRange(button.dataset.trendRange ?? "6m"));
    });
  }
</script>

<style>
  .trend-toolbar,
  .variant-intro,
  .trend-card > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .trend-toolbar {
    margin-bottom: 1rem;
  }
  .range-control {
    display: flex;
    border: 1px solid var(--ink);
    border-radius: 0.35rem;
    overflow: hidden;
  }
  .range-control button {
    min-width: 2.6rem;
    padding: 0.42rem 0.55rem;
    border: 0;
    border-right: 1px solid var(--ink);
    background: var(--paper-high);
    font: 700 0.6rem "Space Mono", monospace;
  }
  .range-control button:last-child {
    border-right: 0;
  }
  .range-control button[aria-pressed="true"] {
    color: var(--paper-high);
    background: var(--ink);
  }
  .range-control button:disabled {
    opacity: 0.3;
  }
  .trend-toolbar > p {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--muted);
    font: 0.58rem "Space Mono", monospace;
  }
  .trend-toolbar > p span {
    width: 0.48rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--muted);
    opacity: 0.55;
  }
  .trend-toolbar > p i {
    width: 1.4rem;
    border-top: 3px solid var(--ink);
  }
  .performance-key,
  .performance-key span {
    display: flex;
    align-items: center;
  }
  .performance-key {
    gap: 0.75rem;
    color: var(--muted);
    font: 0.58rem "Space Mono", monospace;
  }
  .performance-key span {
    gap: 0.28rem;
  }
  .performance-key i {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .performance-key .key-good {
    background: #2f9d63;
  }
  .performance-key .key-average {
    background: #d7a713;
  }
  .performance-key .key-poor {
    background: #d6553b;
  }
  .variant-intro {
    margin-bottom: 1rem;
    font: 0.72rem "Space Mono", monospace;
  }
  .variant-intro span {
    color: var(--muted);
    text-align: right;
  }
  .trend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .trend-card {
    min-width: 0;
    padding: 1rem;
    border: 2px solid var(--ink);
    background: var(--paper-high);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .trend-card > header {
    align-items: start;
    border-bottom: 1px solid var(--outline);
  }
  .trend-card h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .trend-card header p {
    display: block;
    margin: 0.15rem 0 0;
    color: var(--muted);
    font: 0.56rem "Space Mono", monospace;
    text-transform: uppercase;
  }
