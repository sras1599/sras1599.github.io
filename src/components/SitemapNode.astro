---
import { sortSitemapNodes, type SitemapNode } from "../utils/sitemap";

interface Props {
  node: SitemapNode;
  depth?: number;
}

const { node, depth = 0 } = Astro.props;
---

<li class:list={[{ "root-node": depth === 0 }]}>
  {node.children && node.children.size > 0 ? (
    <details open>
      <summary style={`--branch-depth: ${depth + 1}`}>
        <span class="branch-caret" aria-hidden="true">▸</span>
        {node.href ? <a href={node.href}>{node.label}</a> : <span>{node.label}</span>}
      </summary>
      <ul role="list">
        {sortSitemapNodes(node.children.values()).map((child) => <Astro.self node={child} depth={depth + 1} />)}
      </ul>
    </details>
  ) : (
    node.href ? <a href={node.href}>{node.label}</a> : <span>{node.label}</span>
  )}
</li>

<style>
  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary,
  .root-node > a {
    --row-indent: calc(var(--branch-indent) * var(--branch-depth, 1));
    display: block;
    margin-inline-start: calc(-1 * var(--row-indent));
    padding-inline-start: var(--row-indent);
  }

  .branch-caret {
    display: inline-block;
    inline-size: 1.25em;
    text-align: center;
  }

  details[open] > summary > .branch-caret {
    transform: rotate(90deg);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    position: relative;
    padding-inline-start: var(--branch-indent);
  }

  li::before,
  li::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    pointer-events: none;
  }

  li::before {
    inset-block: 0;
    border-inline-start: 1px solid var(--branch-color);
  }

  li:last-child::before {
    inset-block-end: auto;
    block-size: var(--branch-center);
  }

  li::after {
    inset-block-start: var(--branch-center);
    inline-size: calc(var(--branch-indent) - 0.25rem);
    border-block-start: 1px solid var(--branch-color);
  }
</style>
