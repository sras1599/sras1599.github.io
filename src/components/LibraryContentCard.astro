---
interface Props {
  title: string;
  creator?: string;
  year?: number;
  link?: string;
  rating?: number;
}

const { title, creator, year, link, rating } = Astro.props;
const notes = await Astro.slots.render("default");
const hasNotes = Boolean(notes?.replace(/<!--[\s\S]*?-->/g, "").trim());
const starPath =
  "M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26Z";
// The half-star follows the left outline and closes on the exact centerline.
const halfStarPath = "M12 2V17.77L5.82 21.02 7 14.14 2 9.27 8.91 8.26Z";
---

<library-content-card>
<article class="content-card" data-has-notes={hasNotes ? "" : undefined}>
  <header class="card-header">
    <div>
      <h3>{link ? <a href={link}>{title}</a> : title}</h3>
      {creator && <p class="creator">{creator}</p>}
    </div>
    <div class="card-meta">
      {year !== undefined && <span class="year">({year})</span>}
      {rating !== undefined && (
        <div class="rating" role="img" aria-label={`Rated ${rating} out of 5`}>
          <span style="display: flex; gap: 0.15rem;" aria-hidden="true">
            {Array.from({ length: 5 }, (_, index) => (
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                style="display: block; flex-shrink: 0;"
                focusable="false"
              >
                <path
                  d={starPath}
                  fill={rating - index >= 1 ? "var(--ink)" : "var(--paper)"}
                />
                {rating - index > 0 && rating - index < 1 && (
                  <path d={halfStarPath} fill="var(--ink)" />
                )}
                <path
                  d={starPath}
                  fill="none"
                  stroke="var(--ink)"
                  stroke-width="1.3"
                  stroke-linejoin="round"
                />
              </svg>
            ))}
          </span>
        </div>
      )}
    </div>
  </header>

  {hasNotes && (
    <div class="card-body">
      <div class="card-preview">
        <div class="preview-inner">
          <div class="notes library-notes" set:html={notes} />
        </div>
      </div>
      <button
          class="card-expand"
          type="button"
          aria-expanded="false"
          aria-label={`Show more about ${title}`}
        >
          <span class="indicator-line" aria-hidden="true" />
      </button>
    </div>
  )}
</article>
</library-content-card>

<script>
  class LibraryContentCard extends HTMLElement {
    private events?: AbortController;
    private notesObserver?: ResizeObserver;

    connectedCallback() {
      const card = this.querySelector<HTMLElement>(".content-card");
      const button = this.querySelector<HTMLButtonElement>(".card-expand");
      const notes = this.querySelector<HTMLElement>(".notes");
      const preview = this.querySelector<HTMLElement>(".card-preview");
      if (!card || !button || !notes || !preview) return;
      const title = card.querySelector("h3")?.textContent ?? "this item";
      this.events?.abort();
      this.events = new AbortController();

      const updateButton = () => {
        const expanded = card.hasAttribute("data-expanded");
        button.setAttribute("aria-expanded", String(expanded));
        button.setAttribute("aria-label", `${expanded ? "Show less" : "Show more"} about ${title}`);
      };
      const updateOverflow = () => {
        // Measure the unclipped notes against the three-line preview at this width.
        // Hidden search results are measured again when they become visible.
        if (!notes.getClientRects().length) return;
        const limit = parseFloat(getComputedStyle(preview).lineHeight) * 3;
        const expandable = notes.getBoundingClientRect().height > limit + 1;
        card.toggleAttribute("data-expandable", expandable);
        if (!expandable) card.removeAttribute("data-expanded");
        updateButton();
      };

      this.notesObserver?.disconnect();
      this.notesObserver = new ResizeObserver(updateOverflow);
      this.notesObserver.observe(notes);
      updateOverflow();
      button.addEventListener("click", () => {
        if (!card.hasAttribute("data-expandable")) return;
        card.toggleAttribute("data-expanded");
        updateButton();
      }, { signal: this.events.signal });
      card.addEventListener("click", (event) => {
        if (event.defaultPrevented || !card.hasAttribute("data-expandable") || card.hasAttribute("data-expanded")) return;
        if (
          event.target instanceof Element &&
          event.target.closest("a, button, input, select, textarea, [contenteditable]")
        ) return;
        if (window.getSelection()?.toString()) return;
        button.click();
      }, { signal: this.events.signal });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.notesObserver?.disconnect();
    }
  }

  if (!customElements.get("library-content-card")) {
    customElements.define("library-content-card", LibraryContentCard);
  }
</script>

<style>
  library-content-card { display: block; }

  .content-card {
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    min-height: 8rem;
    padding: 1rem 1rem 1.75rem;
    border: 2px solid var(--ink);
    background: var(--paper-high);
    overflow-wrap: anywhere;
  }

  .content-card[data-expandable]:not([data-expanded]) {
    cursor: pointer;
  }

  .content-card[data-expandable] {
    min-height: 12rem;
  }

  .card-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  h3 {
    margin: 0;
    font-family: "Bricolage Grotesque", system-ui, sans-serif;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .year {
    flex-shrink: 0;
    color: var(--muted);
    font:
      700 0.85rem "Space Mono",
      monospace;
  }

  .creator {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-style: italic;
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font:
      700 0.8rem "Space Mono",
      monospace;
  }

  .card-body {
    margin-top: 0.65rem;
  }

  .card-preview {
    display: grid;
    grid-template-rows: 1fr;
    font-size: 0.85rem;
    line-height: 1.55;
    transition: grid-template-rows 280ms ease;
  }

  .content-card[data-expandable] .card-preview {
    grid-template-rows: 0fr;
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 100%);
  }

  .preview-inner {
    min-height: 0;
    overflow: hidden;
  }

  .content-card[data-expandable] .preview-inner {
    min-height: 4.65em;
  }

  .content-card[data-expanded] .card-preview {
    grid-template-rows: 1fr;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .notes {
    --blockquote-margin: 0.5rem 0;
    --blockquote-padding: 0.65rem 0.85rem;
  }

  .notes :global(p) {
    margin: 0;
  }

  .notes :global(p + p) {
    margin-top: 0.5rem;
  }

  .notes :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--purple);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .notes :global(:is(ul, ol)) {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
  }

  .notes :global(:is(img, audio, video)) {
    max-width: 100%;
  }

  .notes :global(img) {
    height: auto;
  }

  .notes :global(pre) {
    overflow-x: auto;
  }

  h3 a:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-color: var(--purple);
    text-underline-offset: 3px;
  }

  .card-expand {
    display: none;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    justify-content: center;
    align-items: center;
    height: 1.625rem;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border: 0;
    background: none;
    color: var(--muted);
    font:
      700 0.85rem / 1.55 "Space Mono",
      monospace;
    cursor: pointer;
  }

  .content-card[data-expandable] .card-expand {
    display: flex;
  }

  .indicator-line {
    width: 2.25rem;
    border-top: 2px solid currentColor;
    transition: transform 500ms ease;
  }

  .content-card[data-expanded] .indicator-line {
    transform: rotate(180deg);
  }

  .card-expand:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-preview,
    .indicator-line {
      transition: none;
    }
  }

  @media (max-width: 520px) {
    .card-header {
      gap: 0.5rem;
    }
  }
</style>
