---
/**
 * Provide the homepage game showcase's typography, month buttons, responsive
 * card grid, mobile carousel viewport and track, game selector, and card chrome.
 * The caller owns carousel behavior, period state, and URL decisions; its cards
 * fill the default slot.
 */
import { Image } from "astro:assets";
import { gameIds } from "../data/games/contracts";
import { gamePresentation } from "./gamePresentation";

type PeriodNavigation = {
  value: string;
  label: string;
  previous: { label: string; disabled: boolean };
  next: { label: string; disabled: boolean };
};

interface Props {
  periodNavigation: PeriodNavigation;
}

const { periodNavigation } = Astro.props;
---

<section
  class="game-showcase section"
  id="games"
  aria-labelledby="games-title"
  data-showcase-period={periodNavigation.value}
>
  <div class="section-heading">
    <p class="eyebrow">Fun</p>
    <h2 id="games-title">The (puzzle) show must go on!</h2>
    <p>
      A snapshot of the online games I play daily (as I sip my <i
        >perfectly brewed</i
      > americano ☕)
    </p>
  </div>

  <nav class="showcase-period-navigation" aria-label="Month selection">
    <button
      type="button"
      disabled={periodNavigation.previous.disabled}
      aria-label={periodNavigation.previous.label}
      data-period-direction="previous"
    >
      <span aria-hidden="true">‹</span>
    </button>
    <strong data-period-label aria-live="polite" aria-atomic="true">
      {periodNavigation.label}
    </strong>
    <button
      type="button"
      disabled={periodNavigation.next.disabled}
      aria-label={periodNavigation.next.label}
      data-period-direction="next"
    >
      <span aria-hidden="true">›</span>
    </button>
  </nav>

  <nav class="game-selection" aria-label="Game selection">
    {
      gameIds.map((game) => (
        <button
          type="button"
          aria-label={gamePresentation[game].title}
          aria-pressed={game === gameIds[0] ? "true" : "false"}
          aria-controls="game-card-grid"
          data-select-game={game}
        >
          <Image src={gamePresentation[game].icon} alt="" />
        </button>
      ))
    }
    <span
      class="game-selection-announcement"
      data-game-selection-announcement
      aria-live="polite"
      aria-atomic="true"></span>
  </nav>

  <div class="game-card-viewport">
    <div
      class="game-card-grid"
      id="game-card-grid"
      role="region"
      aria-label="Daily game results"
    >
      <slot />
    </div>
  </div>
</section>

<style>
  .game-showcase {
    position: relative;
  }

  .section-heading p:last-child {
    color: var(--muted);
  }

  .showcase-period-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin: -1rem 0 1.75rem;
  }

  .showcase-period-navigation button {
    display: grid;
    width: 2.75rem;
    aspect-ratio: 1;
    padding: 0;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    color: var(--ink);
    background: var(--paper-high);
    font: inherit;
    font-size: 1.4rem;
  }

  .showcase-period-navigation button:disabled {
    opacity: 0.25;
  }

  .showcase-period-navigation button:not(:disabled) {
    cursor: pointer;
  }

  .showcase-period-navigation strong {
    display: grid;
    width: 9.75rem;
    padding: 0.55rem 1rem;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 0.4rem;
    box-sizing: border-box;
    font:
      700 0.78rem "Space Mono",
      monospace;
  }

  :is(
    .showcase-period-navigation button,
    .game-selection button
  ):focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: 3px;
  }

  .game-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .game-selection {
    display: none;
  }

  .game-card-grid :global(.game-card) {
    height: 100%;
    min-width: 0;
    padding: 1rem;
    background: var(--paper-high);
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .game-card-grid :global(.game-card > header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.3rem;
    border-bottom: 1px solid var(--outline);
  }

  .game-card-grid :global(.game-card-title) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
  }

  .game-card-grid :global(.game-card-title img) {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .game-card-grid :global(.game-card h3) {
    margin: 0;
    font-size: 1.2rem;
  }

  .game-card-grid :global(.game-card > header a) {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    color: var(--muted);
    font:
      0.64rem "Space Mono",
      monospace;
    text-align: right;
    text-transform: uppercase;
  }

  .game-card-grid :global(.game-card > header a svg) {
    width: 0.7rem;
    height: 0.7rem;
    flex: 0 0 auto;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .game-card-grid :global(.game-card > header a:hover) {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .game-card-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Reserve room inside the viewport for card shadows and focus outlines. */
    .game-showcase[data-game-selection-ready] .game-card-viewport {
      overflow: hidden;
      padding: 7px;
      margin: -7px;
    }

    .game-showcase[data-game-selection-ready] .game-card-grid {
      display: flex;
      gap: 12px;
      touch-action: pan-y pinch-zoom;
    }

    .game-showcase[data-game-selection-ready]
      .game-card-grid
      :global(.game-card) {
      flex: 0 0 100%;
    }

    .game-showcase[data-game-selection-ready] .game-selection {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }

    .game-selection button {
      display: grid;
      width: 2.75rem;
      aspect-ratio: 1;
      padding: 0;
      place-items: center;
      border: 1px solid var(--ink);
      border-radius: 0.3rem;
      background: var(--paper-high);
      cursor: pointer;
    }

    .game-selection button[aria-pressed="true"] {
      background: white;
      border-width: 2px;
    }

    .game-selection img {
      width: 1.5rem;
      height: 1.5rem;
      object-fit: contain;
    }

    .game-selection-announcement {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
