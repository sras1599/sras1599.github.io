---
/**
 * Integrate the complete word-game showcase on the public homepage. This module
 * loads validated repository results, defines the current Kolkata calendar
 * date, renders every selectable Month presentation, and embeds the inert
 * Trends presentation. Its browser controller preserves each view's state,
 * owns canonical URL state, and imports trend chart code only when Trends is
 * first selected. Lower-level presentation modules remain reusable.
 */
import { tz } from "@date-fns/tz";
import { format, subMonths } from "date-fns";

import { loadGameData } from "../data/games/load";
import GameShowcaseFrame from "./GameShowcaseFrame.astro";
import GameShowcaseMonth from "./GameShowcaseMonth.astro";
import GameShowcaseTrends from "./GameShowcaseTrends.astro";

type TrendRange = "3m" | "6m" | "1y" | "all";

const now = new Date();
const inKolkata = { in: tz("Asia/Kolkata") };
const currentLocalDate = format(now, "yyyy-MM-dd", inKolkata);
const selectedMonth = format(now, "yyyy-MM", inKolkata);
const selectedMonthLabel = format(now, "MMMM yyyy", inKolkata);
const gameResults = loadGameData();

/**
 * List every calendar month from the first persisted result through today. A
 * continuous range lets an honestly empty historical month remain selectable
 * instead of implying that a gap in records never existed.
 */
const resultDates = Object.values(gameResults)
  .flat()
  .map((result) => result.date)
  .sort();
const firstResultDate = resultDates[0];
const firstResultMonth = firstResultDate?.slice(0, 7) ?? selectedMonth;
const availableMonths: string[] = [];
const [firstYear, firstMonth] = firstResultMonth.split("-").map(Number);
const [currentYear, currentMonth] = selectedMonth.split("-").map(Number);

for (
  let year = firstYear, month = firstMonth;
  year < currentYear || (year === currentYear && month <= currentMonth);
) {
  availableMonths.push(`${year}-${String(month).padStart(2, "0")}`);
  month += 1;
  if (month === 13) {
    year += 1;
    month = 1;
  }
}

const rangeStarts = {
  "3m": format(subMonths(now, 3), "yyyy-MM-dd", inKolkata),
  "6m": format(subMonths(now, 6), "yyyy-MM-dd", inKolkata),
  "1y": format(subMonths(now, 12), "yyyy-MM-dd", inKolkata),
};
const availableTrendRanges: TrendRange[] = [
  ...(firstResultDate && firstResultDate <= rangeStarts["3m"] ? ["3m" as const] : []),
  ...(firstResultDate && firstResultDate <= rangeStarts["6m"] ? ["6m" as const] : []),
  ...(firstResultDate && firstResultDate <= rangeStarts["1y"] ? ["1y" as const] : []),
  "all",
];
const defaultTrendRange: TrendRange = availableTrendRanges.includes("6m") ? "6m" : "all";
---

<game-showcase-controller>
  <GameShowcaseFrame
    id="games"
    eyebrow="Word games"
    title="A month in word games"
    description="A daily snapshot of the word games I play, including the days I did not record a result."
    activeView="month"
    viewLinks={[
      { view: "month", label: "Month", href: "#games" },
      { view: "trends", label: "Trends", href: `?games=trends&range=${defaultTrendRange}#games` },
    ]}
    periodNavigation={{
      value: selectedMonth,
      label: selectedMonthLabel,
      previous: {
        label: `Previous month, ${format(
          new Date(currentYear, currentMonth - 2, 1),
          "MMMM yyyy",
        )}`,
        disabled: availableMonths.length === 1,
      },
      next: { label: "Next month unavailable", disabled: true },
    }}
  >
    <GameShowcaseMonth
      selectedMonth={selectedMonth}
      currentLocalDate={currentLocalDate}
      results={gameResults}
    />
  </GameShowcaseFrame>

  {
    availableMonths.map((month) => (
      <template data-game-month-template={month}>
        <GameShowcaseMonth
          selectedMonth={month}
          currentLocalDate={currentLocalDate}
          results={gameResults}
        />
      </template>
    ))
  }
  <template data-game-trends-template>
    <GameShowcaseTrends
      id="homepage-game-trends"
      currentLocalDate={currentLocalDate}
      results={gameResults}
      availableRanges={availableTrendRanges}
      defaultRange={defaultTrendRange}
      firstResultDate={firstResultDate}
    />
  </template>
</game-showcase-controller>

<script>
  /**
   * Enhance one rendered showcase instance. The custom element owns its DOM
   * queries and event lifecycle, so adding other homepage scripts cannot create
   * selector or state collisions. It swaps server-rendered Month templates or
   * the inert Trends template, importing charts only for the latter.
   */
  class GameShowcaseController extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      if (this.events) return;

      this.events = new AbortController();
      const { signal } = this.events;

      /** Fail with the broken internal markup contract instead of a null error. */
      const requireElement = <ElementType extends Element>(selector: string) => {
        const element = this.querySelector<ElementType>(selector);
        if (!element) {
          throw new Error(
            `Cannot initialize the homepage game showcase: missing ${selector}`,
          );
        }
        return element;
      };

      const showcase = requireElement<HTMLElement>("#games");
      const defaultMonth = showcase.dataset.showcasePeriod;
      if (!defaultMonth) {
        throw new Error(
          "Cannot initialize the homepage game showcase: missing default month",
        );
      }

      const templates = new Map(
        Array.from(
          this.querySelectorAll<HTMLTemplateElement>(
            "template[data-game-month-template]",
          ),
        ).map(
          (template): [string, HTMLTemplateElement] => [
            template.dataset.gameMonthTemplate!,
            template,
          ],
        ),
      );
      const availableMonths = Array.from(templates.keys()).sort();
      const trendsTemplate = requireElement<HTMLTemplateElement>(
        "template[data-game-trends-template]",
      );
      const trendsSource = trendsTemplate.content.querySelector<HTMLElement>(
        "game-showcase-trends",
      );
      if (!trendsSource) {
        throw new Error(
          "Cannot initialize the homepage game showcase: missing Trends presentation",
        );
      }
      const availableRanges = trendsSource.dataset.availableRanges?.split(",") ?? [];
      const defaultRange = trendsSource.dataset.defaultRange ?? "all";
      const cardGrid = requireElement<HTMLElement>(".game-card-grid");
      const title = requireElement<HTMLElement>("#games-title");
      const description = requireElement<HTMLElement>("#games .section-heading > p:last-child");
      const viewLinks = this.querySelectorAll<HTMLAnchorElement>("[data-showcase-view]");
      const periodNavigation = requireElement<HTMLElement>(
        "[data-showcase-period-navigation]",
      );
      const periodLabel = requireElement<HTMLElement>("[data-period-label]");
      const previousButton = requireElement<HTMLButtonElement>(
        '[data-period-direction="previous"]',
      );
      const nextButton = requireElement<HTMLButtonElement>(
        '[data-period-direction="next"]',
      );
      const monthFormatter = new Intl.DateTimeFormat("en-US", {
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      });
      let activeMonth = defaultMonth;
      let activeRange = defaultRange;
      let activeView: "month" | "trends" = "month";

      /** Format YYYY-MM without allowing the browser's local zone to shift it. */
      const monthLabel = (month: string) => {
        const [year, monthNumber] = month.split("-").map(Number);
        return monthFormatter.format(new Date(Date.UTC(year, monthNumber - 1)));
      };

      /** Keep the shared label and both boundary states aligned with the cards. */
      const updateControls = (month: string) => {
        const index = availableMonths.indexOf(month);
        const previousMonth = availableMonths[index - 1];
        const nextMonth = availableMonths[index + 1];

        periodLabel.textContent = monthLabel(month);
        previousButton.disabled = previousMonth === undefined;
        previousButton.setAttribute(
          "aria-label",
          previousMonth
            ? `Previous month, ${monthLabel(previousMonth)}`
            : "Previous month unavailable",
        );
        nextButton.disabled = nextMonth === undefined;
        nextButton.setAttribute(
          "aria-label",
          nextMonth
            ? `Next month, ${monthLabel(nextMonth)}`
            : "Next month unavailable",
        );
      };

      /** Keep view copy, selected control, and Month-only navigation aligned. */
      const updateViewPresentation = (view: "month" | "trends") => {
        activeView = view;
        title.textContent = view === "month" ? "A month in word games" : "Trends in word games";
        description.textContent = view === "month"
          ? "A daily snapshot of the word games I play, including the days I did not record a result."
          : "Recorded performance over time, using only the games I played in the selected range.";
        periodNavigation.hidden = view === "trends";
        viewLinks.forEach((link) => {
          if (link.dataset.showcaseView === view) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
      };

      /** Encode only non-default Month state while preserving unrelated params. */
      const updateUrl = (month: string, replace: boolean) => {
        const url = new URL(window.location.href);
        url.searchParams.delete("range");
        if (month === defaultMonth) {
          url.searchParams.delete("games");
          url.searchParams.delete("date");
        } else {
          url.searchParams.set("games", "month");
          url.searchParams.set("date", month);
        }

        window.history[replace ? "replaceState" : "pushState"]({}, "", url);
      };

      /** Encode the complete Trends state and remove Month's incompatible date. */
      const updateTrendsUrl = (range: string, replace: boolean) => {
        const url = new URL(window.location.href);
        url.searchParams.set("games", "trends");
        url.searchParams.set("range", range);
        url.searchParams.delete("date");
        window.history[replace ? "replaceState" : "pushState"]({}, "", url);
      };

      /** Replace all four cards from one production-rendered month template. */
      const selectMonth = (
        month: string,
        historyMode: "push" | "replace" | "none",
      ) => {
        const template = templates.get(month);
        if (!template) return;

        cardGrid.replaceChildren(template.content.cloneNode(true));
        activeMonth = month;
        updateViewPresentation("month");
        updateControls(month);

        if (historyMode !== "none") {
          updateUrl(month, historyMode === "replace");
        }
      };

      /** Connect the inert trend markup, then load Plot and upgrade its element. */
      const selectTrends = async (
        range: string,
        historyMode: "push" | "replace" | "none",
      ) => {
        if (!availableRanges.includes(range)) range = defaultRange;
        const content = trendsTemplate.content.cloneNode(true) as DocumentFragment;
        const trends = content.querySelector<HTMLElement>("game-showcase-trends");
        if (trends) trends.dataset.selectedRange = range;
        cardGrid.replaceChildren(content);
        activeRange = range;
        updateViewPresentation("trends");

        if (historyMode !== "none") {
          updateTrendsUrl(range, historyMode === "replace");
        }

        await import("./gameShowcaseTrends");
      };

      /** Accept only the complete documented query shape and available months. */
      const monthFromUrl = () => {
        const params = new URL(window.location.href).searchParams;
        const requestedMonth = params.get("date");
        return params.get("games") === "month" &&
          requestedMonth !== null &&
          templates.has(requestedMonth)
          ? requestedMonth
          : defaultMonth;
      };

      const stateFromUrl = () => {
        const params = new URL(window.location.href).searchParams;
        if (params.get("games") === "trends") {
          const requestedRange = params.get("range");
          return {
            view: "trends" as const,
            range: requestedRange && availableRanges.includes(requestedRange)
              ? requestedRange
              : defaultRange,
            canonical: requestedRange !== null && availableRanges.includes(requestedRange) && !params.has("date"),
          };
        }

        const month = monthFromUrl();
        const canonical = month === defaultMonth
          ? !params.has("games") && !params.has("date") && !params.has("range")
          : params.get("games") === "month" && params.get("date") === month && !params.has("range");
        return { view: "month" as const, month, canonical };
      };

      const restoreUrlState = () => {
        const state = stateFromUrl();
        if (state.view === "trends") {
          void selectTrends(state.range, state.canonical ? "none" : "replace");
        } else {
          selectMonth(state.month, state.canonical ? "none" : "replace");
        }
      };

      restoreUrlState();

      viewLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          if (link.dataset.showcaseView === "trends") {
            void selectTrends(activeRange, "push");
          } else {
            selectMonth(activeMonth, "push");
          }
        }, { signal });
      });

      previousButton.addEventListener(
        "click",
        () => {
          const index = availableMonths.indexOf(activeMonth);
          const previousMonth = availableMonths[index - 1];
          if (previousMonth) selectMonth(previousMonth, "push");
        },
        { signal },
      );
      nextButton.addEventListener(
        "click",
        () => {
          const index = availableMonths.indexOf(activeMonth);
          const nextMonth = availableMonths[index + 1];
          if (nextMonth) selectMonth(nextMonth, "push");
        },
        { signal },
      );
      this.addEventListener(
        "game-trend-range-change",
        (event) => {
          const range = (event as CustomEvent<{ range: string }>).detail.range;
          if (activeView !== "trends" || !availableRanges.includes(range)) return;
          activeRange = range;
          updateTrendsUrl(range, false);
        },
        { signal },
      );
      window.addEventListener(
        "popstate",
        restoreUrlState,
        { signal },
      );
    }

    /** Release page-level listeners if this showcase instance is removed. */
    disconnectedCallback() {
      this.events?.abort();
      this.events = undefined;
    }
  }

  if (!customElements.get("game-showcase-controller")) {
    customElements.define("game-showcase-controller", GameShowcaseController);
  }
</script>

<style>
  game-showcase-controller {
    display: block;
  }
</style>
