---
/**
 * Generate and render one /blog entry for each imported blog item. The rest
 * parameter receives the entry ID unchanged, so slash-separated IDs such as
 * guides/astro/setup continue to produce nested public URLs.
 * This entry template enables previews of links to other collection entries.
 * Blog pages keep a fixed link to the blog index; series links open their
 * introduction directly without carrying return-navigation state.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotePreview from "../../components/NotePreview.astro";
import { blogCollectionDefinition } from "../../collections/blog/definition.mjs";
import { collectionEntryUrl } from "../../collections/definition.mjs";
import { getSeriesDefinition } from "../../data/series";
import { getReadingTime } from "../../utils/readingTime";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const route = blogCollectionDefinition.route;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");
const series = post.data.series
  ? getSeriesDefinition(post.data.series, post.id)
  : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main>
    <article class="article">
      <a class="back-link" href={route}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span>Back to blog</span>
      </a>
      <header class="article-header">
        <div class="article-meta-row">
          <div class="article-meta">
            <time datetime={post.data.publishDate.toISOString()}>
              {
                post.data.publishDate.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime}</span>
          </div>
          {
            series && (
              <a
                class="series-about-link"
                href={collectionEntryUrl(route, series.aboutSlug)}
              >
                {series.aboutLabel}
              </a>
            )
          }
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <ul aria-label="Tags">
          {post.data.tags.map((tag: string) => <li>{tag}</li>)}
        </ul>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </main>
  <NotePreview />
</BaseLayout>
