---
/**
 * Generate and render one /blog entry for each imported blog item. The rest
 * parameter receives the entry ID unchanged, so slash-separated IDs such as
 * guides/astro/setup continue to produce nested public URLs.
 */
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogCollectionDefinition } from "../../collections/blog/definition.mjs";
import { collectionEntryUrl } from "../../collections/definition.mjs";
import { getSeriesDefinition } from "../../data/series";
import { getReadingTime } from "../../utils/readingTime";

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const route = blogCollectionDefinition.route;
const definitions = new Map(
  posts.flatMap((candidate) =>
    candidate.data.series
      ? [[candidate.id, getSeriesDefinition(candidate.data.series, candidate.id)]]
      : [],
  ),
);
const returnSlugs = posts
  .filter((candidate) => definitions.get(candidate.id)?.aboutSlug === post.id)
  .map((candidate) => candidate.id);
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");
const series = post.data.series
  ? getSeriesDefinition(post.data.series, post.id)
  : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main>
    <article class="article">
      <a
        class="back-link"
        href={route}
        data-entry-back-link={returnSlugs.length
          ? returnSlugs.join(" ")
          : undefined}
        data-collection-route={route}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span data-entry-back-label>Back to blog</span>
      </a>
      <header class="article-header">
        <div class="article-meta-row">
          <div class="article-meta">
            <time datetime={post.data.publishDate.toISOString()}>
              {
                post.data.publishDate.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime}</span>
          </div>
          {
            series && (
              <a
                class="series-about-link"
                href={`${collectionEntryUrl(route, series.aboutSlug)}?from=${encodeURIComponent(post.id)}`}
              >
                {series.aboutLabel}
              </a>
            )
          }
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <ul aria-label="Tags">
          {post.data.tags.map((tag: string) => <li>{tag}</li>)}
        </ul>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  const backLink = document.querySelector<HTMLAnchorElement>(
    "[data-entry-back-link]",
  );
  const backLabel = document.querySelector<HTMLElement>(
    "[data-entry-back-label]",
  );
  const allowedSlugs = new Set(backLink?.dataset.entryBackLink?.split(" "));
  const from = new URLSearchParams(window.location.search).get("from");
  const collectionRoute = backLink?.dataset.collectionRoute;
  if (
    backLink &&
    backLabel &&
    collectionRoute &&
    from &&
    allowedSlugs.has(from)
  ) {
    backLink.href = `${collectionRoute}/${from}`;
    backLabel.textContent = "Back to entry";
  }
</script>
