---
import { getCollection } from "astro:content";
import { collectionEntryUrl } from "../collections/definition.mjs";
import { readActiveCollections } from "../collections/manifest.mjs";
import { collectionRenderers } from "../collections/renderers";

export async function getStaticPaths() {
  const loadCollection = getCollection as unknown as (
    name: string,
  ) => Promise<any[]>;
  const paths = [];

  for (const { definition, route } of await readActiveCollections()) {
    const posts = await loadCollection(definition.id);
    const EntryRenderer = collectionRenderers[definition.entryRenderer]?.entry;
    const IndexRenderer = definition.indexRenderer
      ? collectionRenderers[definition.indexRenderer]?.index
      : undefined;
    if (!EntryRenderer) {
      throw new Error(
        `Collection ${definition.id} has unknown entry renderer ${definition.entryRenderer}`,
      );
    }

    if (definition.indexRenderer) {
      if (!IndexRenderer) {
        throw new Error(
          `Collection ${definition.id} has unknown index renderer ${definition.indexRenderer}`,
        );
      }
      paths.push({
        params: { path: route.slice(1) },
        props: {
          kind: "index",
          posts,
          route,
          renderer: definition.indexRenderer,
        },
      });
    }

    for (const post of posts) {
      paths.push({
        params: { path: collectionEntryUrl(route, post.id).slice(1) },
        props: {
          kind: "entry",
          post,
          posts,
          route,
          renderer: definition.entryRenderer,
        },
      });
    }
  }

  return paths;
}

const { kind, post, posts, route, renderer } = Astro.props;
const Renderer =
  kind === "index"
    ? collectionRenderers[renderer]?.index
    : collectionRenderers[renderer]?.entry;
if (!Renderer) throw new Error(`Unknown ${kind} renderer ${renderer}`);
---

<Renderer {...(kind === "index" ? { posts, route } : { post, posts, route })} />
