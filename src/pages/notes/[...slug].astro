---
/**
 * Generate one /notes page for every imported note. Slash-separated IDs retain
 * nested URLs, dates and summaries render only when present, and the
 * shared article markup keeps cross-collection browser previews compatible.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import { formatPublicationDate } from "../../utils/publication";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FolderNavigationLayout from "../../layouts/FolderNavigationLayout.astro";
import NotePreview from "../../components/NotePreview.astro";
import { notesCollectionDefinition } from "../../collections/notes/definition.mjs";

interface Props {
  note: CollectionEntry<"notes">;
}

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const date = note.data.publishDate ? formatPublicationDate(note.data.publishDate) : undefined;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <FolderNavigationLayout collection="notes" navigation={note.data.navigation}>
    <article class="article">
      <a class="back-link" href={notesCollectionDefinition.route}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span>Back to notes</span>
      </a>
      <header class="article-header">
        {date && <time datetime={date}>{date}</time>}
        <h2>{note.data.title}</h2>
        {note.data.description && <p>{note.data.description}</p>}
        {
          note.data.tags.length > 0 && (
            <ul aria-label="Tags">
              {note.data.tags.map((tag: string) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </FolderNavigationLayout>
  <NotePreview />
</BaseLayout>
