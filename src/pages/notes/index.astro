---
/**
 * Render /notes from the authored notes index and imported note entries. Notes
 * outside sidebar folders are ordered newest first with stable ID tie-breaking.
 * Sidebar roots with published overviews appear as directory cards first in the
 * same list, ordered alphabetically; other sidebar entries stay out of the feed.
 */
import { getCollection, render } from "astro:content";
import FeedCard from "../../components/FeedCard.astro";
import { comparePublicationEntries } from "../../utils/publication";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionEntryUrl } from "../../collections/definition.mjs";
import { notesCollectionDefinition } from "../../collections/notes/definition.mjs";

const indexes = await getCollection("collectionIndexes");
const index = indexes.find(
  (candidate) => candidate.data.collection === notesCollectionDefinition.id,
);
if (!index) {
  throw new Error("Notes collection is missing its generated index document");
}

const allNotes = await getCollection("notes");
const directories = allNotes.filter((note) =>
  note.data.directoryCard !== undefined,
).sort((left, right) =>
  left.data.navigation!.root.title.localeCompare(right.data.navigation!.root.title, "en", { numeric: true }),
);
const notes = allNotes.flatMap((note) => {
  if (note.data.navigation || !note.data.publishDate) return [];
  return [{ ...note, data: { ...note.data, publishDate: note.data.publishDate } }];
});
notes.sort(comparePublicationEntries);
const cards = [...directories, ...notes];
const { Content } = await render(index);

---

<BaseLayout title={index.data.title} description={index.data.metaDescription}>
  <main>
    <section class="notes-header" aria-labelledby="notes-title">
      <p class="eyebrow page-title" id="notes-title">{index.data.title}</p>
      <div class="notes-index-body">
        <Content />
      </div>
    </section>

    <section class="post-list" aria-label="Notes">
      {cards.length === 0 && <p>No notes yet.</p>}
      {
        cards.map((note) => (
          <FeedCard
            title={note.data.title}
            href={collectionEntryUrl(notesCollectionDefinition.route, note.id)}
            publishDate={note.data.publishDate}
            description={note.data.description}
            tags={note.data.tags}
            directoryCard={note.data.directoryCard}
          />
        ))
      }
    </section>
  </main>
</BaseLayout>
