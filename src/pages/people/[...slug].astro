---
/**
 * Generate and render one /people page for each imported person note. The rest
 * parameter preserves slash-separated slugs, and the note body is the complete
 * public profile content beneath its note-owned title. People have individual
 * pages but no directory index or contextual back link.
 * This entry template enables previews of links to other collection entries.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotePreview from "../../components/NotePreview.astro";

interface Props {
  person: CollectionEntry<"people">;
}

export async function getStaticPaths() {
  const people = await getCollection("people");

  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---

<BaseLayout title={person.data.title}>
  <main>
    <article class="article">
      <header class="article-header">
        <h2>{person.data.title}</h2>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </main>
  <NotePreview />
</BaseLayout>
