---
/**
 * Render the /people index from the people collection and the index document
 * authored by its root marker. People are listed by title, with their stable
 * slugs breaking ties; the marker body supplies optional introductory content.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionEntryUrl } from "../../collections/definition.mjs";
import { peopleCollectionDefinition } from "../../collections/people/definition.mjs";

const indexes = await getCollection("collectionIndexes");
const index = indexes.find(
  (candidate) => candidate.data.collection === peopleCollectionDefinition.id,
);
if (!index) {
  throw new Error("People collection is missing its generated index document");
}

const people = await getCollection("people");
people.sort(comparePeople);
const { Content } = await render(index);

/** Order people by their displayed title and use the canonical slug for ties. */
function comparePeople(
  left: CollectionEntry<"people">,
  right: CollectionEntry<"people">,
) {
  const titleOrder = left.data.title.localeCompare(right.data.title, "en", {
    sensitivity: "base",
  });

  return titleOrder || left.id.localeCompare(right.id, "en");
}
---

<BaseLayout title={index.data.title} description={index.data.metaDescription}>
  <main>
    <section class="blog-header" aria-labelledby="people-title">
      <p class="eyebrow" id="people-title">{index.data.title}</p>
      <div class="blog-index-body">
        <Content />
      </div>
    </section>

    <section class="post-list" aria-label="People">
      {people.length === 0 && <p>No people yet.</p>}
      {
        people.map((person) => (
          <article class="post-card">
            <h2>
              <a
                href={collectionEntryUrl(
                  peopleCollectionDefinition.route,
                  person.id,
                )}
              >
                {person.data.title}
              </a>
            </h2>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
