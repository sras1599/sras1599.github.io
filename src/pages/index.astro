---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Word-Dash",
    type: "Game",
    description:
      "A fast-paced word game that tests your speed and vocabulary at the same time.",
    href: "https://word-dash.rasmalai.dev",
    hosted: false,
    year: 2026, // optional
    accent: "blue",
    github: "https://github.com/sras1599/word-dash",
  },
];

const links = [
  {
    label: "GitHub",
    href: "https://github.com/sras1599",
    umamiEvent: "Viewed GitHub",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/singh-ras/",
    umamiEvent: "Viewed LinkedIn",
  },
  { label: "Email", href: "mailto:raspreet800@gmail.com" },
];
---

<BaseLayout>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h4 id="hero-title">Hello There!</h4>
        <p class="hero-lede">
          I am Raspreet Singh. I love programming, word games, badminton, and
          mountaineering. I got disillusioned with my work in the IT sector and
          left my job. I'm now looking for work that I can be more satisfied
          with.

          <br /><br />
          I don't live my life with any innate purpose. I exist to <i>wander</i
          >.
        </p>
      </div>
      <div class="hero-art">
        <span class="blob blob-blue" aria-hidden="true"></span>
        <img
          class="hero-profile"
          src="/assets/profile.webp"
          alt="Raspreet Singh"
        />
      </div>
    </section>

    <section
      class="section work-section"
      id="work"
      aria-labelledby="work-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Work</p>
        <h2 id="work-title">
          What I've built, and what I'm building currently
        </h2>
      </div>
      <div class="project-grid">
        {
          projects.map((project, index) => (
            <article class={`project-card project-card-${project.accent}`}>
              <div class="project-media" aria-hidden="true">
                <span>{project.type}</span>
              </div>
              <div class="project-body">
                <div class="project-meta">
                  <p class="project-type">{project.type}</p>
                  {project.year && (
                    <span class="project-year">{project.year}</span>
                  )}
                </div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="project-actions">
                  {project.hosted ? (
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.type === "Game" ? "Play Now" : "Open project"} (opens in a new tab)`}
                    >
                      {project.type === "Game" ? "Play Now" : "Open project"}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  ) : (
                    <span class="project-unavailable">
                      <button
                        type="button"
                        aria-disabled="true"
                        aria-describedby={`hosting-note-${index}`}
                      >
                        {project.type === "Game" ? "Play Now" : "Open project"}
                      </button>
                      <span
                        class="project-hosting-note"
                        id={`hosting-note-${index}`}
                        role="tooltip"
                      >
                        Not hosted right now
                      </span>
                    </span>
                  )}
                  {project.github && (
                    <>
                      <span class="project-action-divider" aria-hidden="true">
                        |
                      </span>
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="GitHub (opens in a new tab)"
                      >
                        GitHub<span aria-hidden="true"> ↗</span>
                      </a>
                    </>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <p class="eyebrow">Contact</p>
      <h3 id="contact-title">*I rarely post on social media though</h3>
      <div class="contact-links">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-umami-event={link.umamiEvent}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={
                link.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLElement>(".project-unavailable")
    .forEach((action) => {
      const button = action.querySelector("button")!;
      const reveal = () => {
        delete action.dataset.dismissed;
      };
      action.addEventListener("pointerenter", reveal);
      button.addEventListener("focus", reveal);
      button.addEventListener("click", () => {
        reveal();
        button.focus();
      });
      button.addEventListener("keydown", (event) => {
        if (event.key === "Escape") action.dataset.dismissed = "true";
      });
    });
</script>
