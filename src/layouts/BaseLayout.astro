---
/**
 * Provide the shared HTML document shell, metadata, fonts, and primary
 * navigation for website pages. Callers supply optional page title and
 * description text; website-owned collection definitions supply fixed links.
 * Authored abbreviations are enhanced into focusable, styled tooltips while
 * retaining an accessible label containing both the term and its expansion.
 * Desktop presents the brand and navigation in one row, while mobile centers
 * the brand above a compact row containing all four navigation destinations.
 */
import "../styles/global.css";
import { blogCollectionDefinition } from "../collections/blog/definition.mjs";
import { notesCollectionDefinition } from "../collections/notes/definition.mjs";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Raspreet Singh",
  description = "Raspreet Singh's personal website",
} = Astro.props;

const pageTitle =
  title === "Raspreet Singh" ? title : `${title} | Raspreet Singh`;
const blogRoute = blogCollectionDefinition.route;
const notesRoute = notesCollectionDefinition.route;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Bricolage+Grotesque:wght@600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="8bd0129b-fca1-4a2f-bf0e-39d7ddf9bf03"
      data-domains="rasmalai.dev"></script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-mark" href="/" aria-label="Raspreet Singh home"
          >Raspreet</a
        >
        <nav class="site-nav" aria-label="Primary navigation">
          <a class="nav-work" href="/#work">Work</a>
          <a class="nav-blog" href={blogRoute}>Blog</a>
          <a class="nav-notes" href={notesRoute}>Notes</a>
          <a class="nav-cta" href="/#contact">Contact</a>
        </nav>
      </header>
      <slot />
    </div>
    <script>
      /**
       * Replace unstyleable browser title popups on authored abbreviations with
       * data-backed tooltips. The accessible label preserves the relationship
       * between each abbreviated term and its expansion after `title` is removed.
       */
      document
        .querySelectorAll<HTMLElement>(".article-body abbr[title]")
        .forEach((abbreviation) => {
          const expansion = abbreviation.getAttribute("title");
          if (!expansion) return;

          const term = abbreviation.textContent?.trim();
          abbreviation.dataset.tooltip = expansion;
          abbreviation.setAttribute(
            "aria-label",
            term ? `${term}: ${expansion}` : expansion,
          );
          abbreviation.tabIndex = 0;
          abbreviation.removeAttribute("title");
        });
    </script>
  </body>
</html>
