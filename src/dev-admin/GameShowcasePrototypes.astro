---
/**
 * Render the game-showcase design fixtures on a dedicated development-only page.
 * The development integration injects this route, so neither the page nor its
 * synthetic histories enter the production route graph. This page retains only
 * the disposable design reference; the production presentation is mounted on
 * the public homepage with repository-owned results.
 */
import GameShowcasePrototype from "../components/GameShowcasePrototype.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Game showcase prototypes"
  description="Development-only game showcase design fixtures"
>
  <main>
    <p class="development-tools-link">
      <a href="/admin">← Development tools</a>
    </p>
    <GameShowcasePrototype />
  </main>
</BaseLayout>

<style>
  .development-tools-link {
    width: min(1120px, calc(100% - 2rem));
    margin: 1.5rem auto 0;
    font: 700 0.75rem "Space Mono", monospace;
  }
</style>
